# 환경변수 안내 파일. 키 이름만 적고 실제 값은 넣지 않는다.
# 사용법: 이 파일을 복사해서 .env를 만들고 값을 채운다. (.env는 커밋 금지)
#   PowerShell: Copy-Item .env.example .env
#
# 키는 해당 기능을 만들 때 하나씩 추가한다.

# ---- PostgreSQL (docker-compose.yml에서 사용) ----
POSTGRES_DB=stock_news
POSTGRES_USER=stock_news
POSTGRES_PASSWORD=

# ---- Massive(구 Polygon) API 키: https://massive.com 대시보드 > API Keys ----
POLYGON_API_KEY=
